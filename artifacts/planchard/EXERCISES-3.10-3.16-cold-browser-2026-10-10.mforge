aints\":[],\"entities\":[],\"id\":\"sk_1qf0m\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791636918429},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1qf0m","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2ea19k","documentVersion":1,"context":{"kind":"part","units":{"length":"in","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Source PDF179-180 / printed3-51-52. Native answer worksheet for combined hole callouts, book-context true/false drafting conventions, book-example1/4-20-2 UNC2A thread note and MMC/maximum-clearance calculations. Inches as explicitly labelled. No new CAD solids or physical manufacturing/standards certification claimed."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"in","scale":[1,1],"showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nr4jrgcu","x":35.74790500320958,"y":18.808251734806483,"text":"EXERCISE 3.10A / PDF179 / 3-51 / INCHES\nDiameter .2500 THRU ALL: full part thickness.\nCounterbore symbol: cylindrical flat-bottom recess.\nCounterbore diameter .5000.\nDepth symbol: recess depth .1250.\nThe counterbore is distinct from the through bore.","leader":null},{"id":"nt81m58g","x":35.74790500320958,"y":68.84915306523979,"text":"EXERCISE 3.10B / PDF179 / 3-51 / INCHES\nDiameter .3970 THRU ALL: full part thickness.\nCountersink symbol: conical recess.\nCountersink diameter .7731, included angle82deg.\nCounterbore / flat recess diameter .7731, depth .0402.\nBoth recess operations appear in the source callout.","leader":null},{"id":"nlzflfal","x":35.74790500320958,"y":123.89411245908349,"text":"EXERCISE 3.14 / PDF180 / 3-52 / INCHES\nSource thread note:1/4-20-2 UNC2A.\nPitch:1/20=.050in.\nMajor diameter:1/4=.250in.\nExternal male thread: suffix A.\nRight-hand and single-start unless otherwise specified.","leader":null},{"id":"n4b2g0ug","x":35.74790500320958,"y":173.9350040714462,"text":"EXERCISE 3.14 - CONTINUED\n20 threads per inch.\nClass2A, UNC coarse series.\nLength2in in this book example notation.\nBook explanation:PDF171 / printed3-43.\nThe middle2 denotes length here, not another fit class.","leader":null},{"id":"nal0vd9h","x":235.91147145266046,"y":18.808251734806483,"text":"EXERCISES 3.11 / 3.12 / PDF179 / 3-51\n3.11 TRUE: class1 is the loosest thread fit.\n3.12 first statement FALSE.\nThe upper limit is placed ABOVE the lower limit.\n3.12 second statement TRUE.\nOn one line the lower limit precedes the higher.","leader":null},{"id":"nzxyhxn7","x":235.91147145266046,"y":73.85323056479136,"text":"EXERCISE 3.13 / PDF179 / 3-51\nInch statement FALSE: trailing zeros indicate precision.\nFor inch values below1, the book omits leading0.\nMetric statement FALSE: do not round all values to whole mm.\nWhole-mm values omit decimal zeros in this convention.\nMetric values below1mm use a leading0.","leader":null},{"id":"nwm97ope","x":235.91147145266046,"y":128.89821911284682,"text":"EXERCISES 3.15 / 3.16 / PDF180 / 3-52 / INCHES\nHole limits:1.124 to1.126.\nShaft limits:1.121 to1.124.\n3.15 MMC allowance=1.124-1.124=.000in.\nLine-to-line at the tightest permissible fit.\n3.16 maximum clearance=1.126-1.121=.005in.","leader":null},{"id":"n0tqejbs","x":235.91147145266046,"y":183.9431979428317,"text":"WORKSHEET SCOPE\nAnswers follow the supplied book examples.\nAll callout dimensions and fit values are inches.\nDrafting convention statements are book-context answers.\nNo current standards-edition certification is claimed.\nNo placeholder CAD solid or invented source dimensions.","leader":null}],"primitives":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"EXERCISES 3.10-3.16 - HOLES THREADS FITS","number":"PLANCHARD 3-51/52 / PDF179/180","author":"","company":"","material":"","finish":"","mass":"","date":"2026-10-10","tolerance":""},"seeded":true},"lastStandardsAudit":{"at":1791636835528,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"in","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2ea19k"}},"attachments":[]}