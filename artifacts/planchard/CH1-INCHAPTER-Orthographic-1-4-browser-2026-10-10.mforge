:\"plane:top\"}]}","issues":[],"rebuiltAt":1791661036769},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_17ezo","variables":[],"referenceGeometry":[],"definitionId":"cm_mv2sp70r","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Inferred orthographic answers, PDF 65-67 / printed 1-37-1-39; not publisher answer key."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nny9niei","x":40.85704456393054,"y":28.922440602138195,"text":"CHAPTER 1 IN-CHAPTER: ORTHOGRAPHIC 1-4\nPDF 65-67 / printed 1-37-1-39\nInferred solutions from the figures; not a publisher answer key.\nThe sheet frame is third-angle; Exercise 1 describes first-angle.","leader":null},{"id":"nl46iyul","x":40.85704456393054,"y":63.95103168935209,"text":"ORTHOGRAPHIC 1 - PDF 65 / 1-37\nFIRST-ANGLE: RIGHT left of FRONT; LEFT right of FRONT;\nBACK far right; TOP below FRONT; BOTTOM already above.\nTop/bottom and left/right look from opposite sides.\nTheir facing features and projected directions differ.\nFRONT has no hidden lines here; shown TOP also has none.\n\nORTHOGRAPHIC 2 - PDF 66 / 1-38\n2 views define this rectangular box:\nFront gives width 2.00 and height 1.00; Top supplies depth 1.50.\nA third view repeats these sizes.\n\nORTHOGRAPHIC 3 - PDF 66 / 1-38\n1 view with a spherical-diameter note defines the sphere.\nAll principal projections are the same circle.\nThe sphere note distinguishes it from a disk/cylinder.\n\nORTHOGRAPHIC 4 - PDF 67 / 1-39\nChoose FRONT: its bottom U-notch and block outline\ndescribe the main shape clearly with few hidden lines.\nTOP is also needed to define the circular through-bore.","leader":null}],"primitives":[],"images":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"Planchard Ch1 IN-CHAPTER Orthographic 1-4 - browser 2026-10-10","number":"","author":"","company":"","material":"","finish":"","mass":"","date":"","tolerance":""},"assemblyLayout":false,"seeded":true},"lastStandardsAudit":{"at":1791661026089,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2sp70r"}},"attachments":[]}