{"version":3,"createdAt":1791627812665,"mainModel":{"schemaVersion":8,"id":"cm_mv28me05","key":"cm_mv28me05","name":"Planchard Chapter3 - review Q1-Q14 - browser 2026-10-10","kind":"part","authoringMode":"fully-parametric","localFrame":{"origin":{"x":0,"y":0,"z":0},"xAxis":{"x":1,"y":0,"z":0},"yAxis":{"x":0,"y":1,"z":0},"zAxis":{"x":0,"y":0,"z":1}},"references":[{"id":"origin","type":"origin","name":"Origin","origin":{"x":0,"y":0,"z":0}},{"id":"plane:top","type":"plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"parameters":{},"sketches":[{"id":"sk_2drd2","name":"X·Z sketch","plane":"top","offset":0,"referenceId":"plane:top","points":[],"entities":[],"constraints":[],"diagnostics":[],"status":"fully-defined"}],"features":[],"history":[{"id":"history:sketch:sk_2drd2","kind":"sketch","targetId":"sk_2drd2","name":"X·Z sketch","suppressed":false,"status":"rebuilt"}],"parts":[],"assemblies":[],"appearances":[],"notes":[],"markups":[],"rules":{},"metadata":{"authoringSystem":"parametric-v1"},"topologyBindings":[],"namedSelections":[],"revision":1,"lastRebuild":{"ok":true,"signature":"{\"definitionId\":\"cm_mv28me05\",\"features\":[],\"history\":[{\"id\":\"history:sketch:sk_2drd2\",\"kind\":\"sketch\",\"suppressed\":false,\"targetId\":\"sk_2drd2\"}],\"overrides\":{},\"revision\":1,\"sketches\":[{\"constraints\":[],\"entities\":[],\"id\":\"sk_2drd2\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791627777282},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_2drd2","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv28me05","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Independent Chapter3 review Q1-Q14, printed3-46/PDF174: dimensions, tolerances, thread classes and double-start pitch/lead. Required counterbore/countersink outlines on separately authored companion sheet. No publisher answer-key, new CAD geometry or certification claim."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"n6vylfwq","x":34.755904449194375,"y":24.64126801587906,"text":"CHAPTER3 - REVIEW ANSWERS Q1-Q14\nSource: printed3-46 / PDF174, Planchard2021.\nIndependent explanations; hole outlines on companion.\nNo official answer-key, authored CAD or certification claim.","leader":null},{"id":"nq07azbu","x":34.755904449194375,"y":59.6884669389522,"text":"Q1 - Duplicate/reference dimensions\nTrue. Define a feature once; supplementary reference values are\nparenthesized and should not add an independent manufacturing constraint.","leader":null},{"id":"n7o2vpx8","x":34.755904449194375,"y":75.2093767842327,"text":"Q2 - IPS\nInch,Pound,Second.","leader":null},{"id":"nmdkloxo","x":34.755904449194375,"y":87.22556031987155,"text":"Q3 - Hole-diameter view\nThe view where the hole appears as a circle.","leader":null},{"id":"ns1z9ml1","x":34.755904449194375,"y":99.2417438555104,"text":"Q4 - Cylinder size view\nThe view where the cylinder appears as a rectangle normally carries its\nlength and diameter, withØ indicating diameter.","leader":null},{"id":"nc5ufugw","x":34.755904449194375,"y":114.7626537007909,"text":"Q5 - Hole dimensioning\nSpecify its diameter and locate its center from suitable datums/edges; add\ndepth/THRU and other hole details when necessary.","leader":null},{"id":"nyjrhm1t","x":34.755904449194375,"y":130.28354521083043,"text":"Q6 - Hidden-line dimensions\nTrue. Prefer a visible or section view; avoid dimensioning to hidden lines\nwhen a clearer representation is available.","leader":null},{"id":"nym5c6sg","x":34.755904449194375,"y":145.80445505611092,"text":"Q7 - Through-hole suffix\nTHRU.","leader":null},{"id":"n002hkan","x":225.01213765172912,"y":59.6884669389522,"text":"Q8 - Unilateral tolerance\nTrue. The permitted variation lies on only one side of\nnominal,e.g.+0.02/−0.00 or+0.00/−0.02.","leader":null},{"id":"nmbscehc","x":225.01213765172912,"y":75.2093767842327,"text":"Q9 - Angular subdivisions\nMinutes and seconds:60minutes per degree,60seconds per minute. Use′ and″\nwhen appropriate.","leader":null},{"id":"ngyybs7e","x":225.01213765172912,"y":90.73028662951322,"text":"Q10 - External thread suffix\nA,e.g.2A.","leader":null},{"id":"nzzs7gm4","x":225.01213765172912,"y":102.74647016515206,"text":"Q11 - Internal thread suffix\nB,e.g.2B.","leader":null},{"id":"nanlcg1h","x":225.01213765172912,"y":114.7626537007909,"text":"Q12 - Thread fit classes\nClass1:loose/easy assembly;Class2:general-purpose commercial\nfit;Class3:close precision fit. A/B distinguishes external/internal,not a\nfourth fit class.","leader":null},{"id":"nfy6t0vw","x":225.01213765172912,"y":133.78827152047208,"text":"Q13 - 3/8-16 UNC2B DOUBLE pitch\nPitch=1/16in=0.0625in between adjacent threads. DOUBLE means two starts,so\nlead=2×pitch=0.125in per revolution.3/8in is major diameter,UNC coarse\nseries,2B internal general-purpose class.","leader":null},{"id":"n4iaovpf","x":225.01213765172912,"y":152.81388934015325,"text":"Q14 - Hole symbols\nCounterbore:⌴,a flat-bottom enlarged recess; Countersink:⌵,a conical\nenlarged mouth. Reproduce the source symbol outlines visibly in the browser\nworksheet.","leader":null}],"primitives":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"CHAPTER3 - REVIEW Q1-Q14","number":"PLANCHARD3-46-PDF174","author":"","company":"","material":"","finish":"","mass":"","date":"2026-10-10","tolerance":""},"seeded":true},"lastStandardsAudit":{"at":1791627359098,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv28me05"}},"attachments":[]}