n\":1,\"sketches\":[{\"constraints\":[],\"entities\":[],\"id\":\"sk_1uai6\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791650923930},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1uai6","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2metx9_6409","documentVersion":1,"context":{"kind":"part","units":{"length":"cm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":[1,1],"showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"n0xmocku","x":40.85704456393054,"y":28.603998864981705,"text":"CH11: DIGITAL STUDY / PHYSICAL CHECKS — PDF548–555, 11-28–11-35\nDigital slicing/export does not demonstrate a successful physical print.\nPDF549: suggested fit tolerances: tight ±0.1; hinge ±0.2; loose ±0.3 mm.\nThese are process guidelines, not specified nominal clearance values.\nExisting 8.2 geometry: AXLE Ø4.7752 mm; FLAT BAR bore Ø4.8260 mm.\nNominal gap: 0.0508 mm diametral; 0.0254 mm radial when concentric.\nPDF551: optional pads Ø10 mm, 1–2 layers; here 0.2–0.4 mm at 0.2 mm/layer.\nPDF551: 30°–150° self-support guideline depends on process and geometry.\nPDF552: layer height guideline = 1/4–1/2 nozzle diameter, printer dependent.\nPDF549: smallest-feature rule ≈ twice thread width; 0.4 mm implies 0.8 mm.\nPDF553: 15–20% infill is a guideline; orientation affects printed strength.\nPDF552: closed mesh and clearance help avoid fusing or trapped support.\nPDF548–550/553: bed cleaning, leveling, temperature and fit need real tests.\nPDF554: device drivers, printer networking and camera monitoring unverified.\nPDF555: external learning account, quizzes and certification uncompleted.","leader":null}],"primitives":[],"images":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"CH11 FIT AND PROCESS GUIDELINES","number":"GUIDE-11","author":"","company":"MODELFORGE BOOK STUDY","material":"","finish":"","mass":"","date":"","tolerance":""},"precision":2,"trailingZeros":true,"sheetFormat":{"id":"6bd514b2-3280-47f6-a9f4-319d7142b6af","name":"MY-A-FORMAT","version":1},"templateSource":{"id":"b405c56c-fa0e-46e0-9bdf-c585022bf3cd","name":"A-IN-ANSI","version":1},"assemblyLayout":false,"seeded":true},"lastStandardsAudit":{"at":1791650560617,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"cm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2metx9_6409"}},"attachments":[]}