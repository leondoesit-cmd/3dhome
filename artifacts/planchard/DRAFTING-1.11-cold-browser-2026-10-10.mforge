onstraints\":[],\"entities\":[],\"id\":\"sk_1ojvu\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791594085716},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1ojvu","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv1on4xy","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Exercise 1.11 / printed 1-58 / PDF86. Conventional Front facing C/A and Right facing J. Visible labeled face areas only; edge-on boundaries and occluded surfaces distinguished. Source interpretation worksheet; no dimensions/material/3D reconstruction required by this question."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nr8c7ikz","x":39.66250661449991,"y":29.648008099855083,"text":"EXERCISE 1.11 - VISIBLE SURFACE IDENTIFICATION\nEngineering Graphics with SOLIDWORKS 2021\nSource: printed 1-58 / PDF86, lettered isometric A-J.\nFront faces the large notched face C and base fascia A.\nRight faces the short base fascia J.\nLists below identify visible face AREAS, excluding edge-on boundaries.","leader":null},{"id":"nbukd099","x":39.76265370079089,"y":89.72892577804932,"text":"FRONT VIEW\nVisible surfaces: A, C, G, I\nA - long base front fascia\nC - main notched upright front\nG - vertical bevel / corner facet\nI - front triangular rib side","leader":null},{"id":"noi0py6y","x":159.92448905717936,"y":89.72892577804932,"text":"TOP VIEW\nVisible surfaces: B, D, E, F, H\nB - exposed base top\nD, F - left and right top lands\nE - curved semicylindrical trough\nH - sloping rib top","leader":null},{"id":"nfn43xjl","x":280.0863244135678,"y":89.72892577804932,"text":"RIGHT VIEW\nVisible surfaces: G, H, J\nG - vertical bevel / corner facet\nH - sloping rib top\nJ - short right base fascia\nE is occluded by the right land/side.","leader":null},{"id":"ntzqxj8y","x":39.76265370079089,"y":154.81659270784007,"text":"WHY THE LISTS DIFFER\nG is a bevel: its face area appears in both Front and Right.\nH is the rib top: area appears in Top and Right, a diagonal edge in Front.\nI is the front triangular rib side: area appears in Front only.\nE has a curved notch boundary in Front, but its surface is edge-on there.\nAn edge-on face may contribute visible outlines without visible face area.\nThis answers the source question under the stated Front convention.\nNo physical dimensions, material, dummy solid or source answer key is claimed.","leader":null}],"primitives":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"EXERCISE 1.11 - SURFACE IDENTIFICATION","number":"PLANCHARD 1-58 / PDF86","author":"","company":"","material":"","finish":"","mass":"","date":"2026-10-10","tolerance":""},"seeded":true},"lastStandardsAudit":{"at":1791593825138,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv1on4xy"}},"attachments":[]}