ints\":[],\"entities\":[],\"id\":\"sk_24r7g\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791632003307},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_24r7g","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2bagya","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Source PDF258-259/printed5-40 and5-41. Exercises5.1-5.5 ask selected construction plane/material. Qualified design choices A Top/B Front/B Front/C Right/C Aluminum Alloys under explicit Y-up, X-width, Z-depth convention; no official answer key or recovered publisher native plane IDs. 5.4 genuine feasible Right-section Boss plus two Cuts; alternate Front ordering also defensible. Answer worksheet only, not invented source model history."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"n05diqtu","x":40.75199222083174,"y":18.808251734806483,"text":"EXERCISES 5.1-5.5 - QUALIFIED DESIGN CHOICES\nSource: PDF258-259 / pages5-40 and5-41.\nConvention: Y up; X width; Z depth.\nFront=X-Y, Right=Y-Z, Top=X-Z; not an official answer key.","leader":null},{"id":"nwzpjq79","x":40.75199222083174,"y":53.83688169430274,"text":"5.1 - A: TOP PLANE\nSketch the full horizontal T footprint; extrude vertically along Y.\nOne Boss includes both branches at the same height.","leader":null},{"id":"nki1ggj0","x":40.75199222083174,"y":70.35037145606996,"text":"5.2 - B: FRONT PLANE\nSketch the complete upright H-like section, posts and feet in X-Y.\nExtrude along Z; upper and lower notches belong to the profile.\nOne Boss gives the repeated front/back section and joining web.","leader":null},{"id":"n7npjacy","x":40.75199222083174,"y":90.36673004462918,"text":"5.3 - B: FRONT PLANE\nSketch all three stair heights in the near X-Y section; extrude Z.\nAdd a Top-plane rectangular Cut for the low-tier plan notch.\nOne Boss plus one Cut; an unnotched stair alone is incomplete.","leader":null},{"id":"n99k802t","x":40.75199222083174,"y":110.38307891511779,"text":"5.4 - C: RIGHT PLANE - OUR CONSTRUCTION CHOICE\nSketch the Y-Z base, low front step and high rear wall; extrude X.\nCut the interior front area to the base, preserving the left return.\nLower the rear wall at the right end with a second Cut.\nThree features; a different Front-plane order can also be valid.","leader":null},{"id":"nvbl907p","x":40.75199222083174,"y":133.90230633046897,"text":"5.5 - C: ALUMINUM ALLOYS\n6061 is an aluminum alloy in the source's material categories.","leader":null}],"primitives":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"EXERCISES5.1-5.5 - QUALIFIED PLANE CHOICES","number":"PLANCHARD5-40-41-PDF258-259","author":"","company":"","material":"","finish":"","mass":"","date":"2026-10-10","tolerance":""},"seeded":true},"lastStandardsAudit":{"at":1791631837099,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2bagya"}},"attachments":[]}