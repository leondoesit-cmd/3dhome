top\"}]}","issues":[],"rebuiltAt":1791622520233},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_17x6l","variables":[],"referenceGeometry":[],"definitionId":"cm_mv25rf2r","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Exercise2.4 printed2-41/PDF127. Source pictures in left-to-right order have3,2,1 vanishing points. Actual browser answer worksheet; no solid required."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nqo14mab","x":39.76265370079089,"y":34.6547573514516,"text":"EXERCISE 2.4 - VANISHING POINTS\nSource: Engineering Graphics with SOLIDWORKS2021.\nPrinted2-41 / PDF127; three source pictures left to right.\nPerspective convergence, not axonometric parallel projection.","leader":null},{"id":"nflo29ee","x":39.76265370079089,"y":84.7221948616938,"text":"PICTURE1 - LEFT: THREE\nBoth horizontal direction families converge.\nThe vertical column edges also converge.\nThree independent vanishing directions.","leader":null},{"id":"n9ze0ao8","x":169.9379692251314,"y":84.7221948616938,"text":"PICTURE2 - MIDDLE: TWO\nBoth horizontal direction families converge.\nVertical column edges remain parallel.\nTwo horizontal vanishing directions.","leader":null},{"id":"nacqvif4","x":300.1132847494719,"y":84.7221948616938,"text":"PICTURE3 - RIGHT: ONE\nFront horizontals and verticals remain parallel.\nOnly the receding depth family converges.\nOne depth vanishing direction.","leader":null},{"id":"nbdwjfzl","x":39.76265370079089,"y":144.80311253988802,"text":"ANSWER ORDER: 3 / 2 / 1\nRead the pictures in their printed left-to-right order.\nThese are reasoned answers from the source images.\nNo physical size, native solid or official answer key is claimed.","leader":null}],"primitives":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"EXERCISE 2.4 - VANISHING POINTS","number":"PLANCHARD 2-41 / PDF127","author":"","company":"","material":"","finish":"","mass":"","date":"2026-10-10","tolerance":""},"seeded":true},"lastStandardsAudit":{"at":1791622509387,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv25rf2r"}},"attachments":[]}