traints\":[],\"entities\":[],\"id\":\"sk_1d7r1\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791660949659},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1d7r1","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2sl8q8","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Inferred answers to in-chapter prompts, PDF 53-54 / printed 1-25-1-26; not publisher answer key."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nvekgx82","x":40.85704456393054,"y":28.922440602138195,"text":"CHAPTER 1 IN-CHAPTER: ALPHABET OF LINES 1-3\nPDF 53-54 / printed 1-25-1-26\nInferred answers from the figures; not a publisher answer key.","leader":null},{"id":"n7x6u1m8","x":40.85704456393054,"y":63.95103168935209,"text":"ALPHABET 1 - PDF 53 / 1-25\n4 functional types: Visible/object, Hidden, Dimension, Extension.\nHidden edges use short dashes; extensions locate dimensions.\n\nALPHABET 2 - PDF 53 / 1-25\n3 types: Visible/object, Center, Section/hatching.\nThe screw axes and bore centre marks are Center lines.\nDiagonal material lines are Section lining.\n\nALPHABET 3 - PDF 54 / 1-26\n7 types: Visible, Hidden, Center, Dimension, Extension, Leader, Break.\nHole/radius callouts use Leaders; shortened length uses Break.","leader":null}],"primitives":[],"images":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"Planchard Ch1 IN-CHAPTER Alphabet of Lines 1-3 - browser 2026-10-10","number":"","author":"","company":"","material":"","finish":"","mass":"","date":"","tolerance":""},"assemblyLayout":false,"seeded":true},"lastStandardsAudit":{"at":1791660857542,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2sl8q8"}},"attachments":[]}