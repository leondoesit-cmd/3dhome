[],\"entities\":[],\"id\":\"sk_1sr9h\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791663855395},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1sr9h","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2uc002","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Source-positional view and extent answers, Planchard2021 PDF106 / 2-20 and PDF113 / 2-27. Inferred labels, no nominal dimensions or recreated CAD solids."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"na4jdkrx","x":34.73022865082227,"y":24.82728452697962,"text":"CHAPTER2 - IN-CHAPTER VIEW LABELS\nProvided Planchard2021 PDF106 and113.\nSource positions identify each pictured view.\nW/H/D names; no nominal dimensions or CAD.","leader":null},{"id":"n07udjkc","x":34.73022865082227,"y":54.82450005434921,"text":"EXERCISE2 - PDF106 / PAGE2-20\nThird-angle projection; extent names only.\nAbove centre: TOP - WIDTH / DEPTH.\nFar left: BACK - WIDTH / HEIGHT.\nLeft of centre: LEFT - DEPTH / HEIGHT.\nCentre: FRONT - WIDTH / HEIGHT.\nRight of centre: RIGHT - DEPTH / HEIGHT.\nBelow centre: BOTTOM - WIDTH / DEPTH.\nUpper-right picture: ISOMETRIC.\nPairs above mean horizontal / vertical.\nIsometric WIDTH spans the bracket flange.\nDEPTH follows the base toward the flange.\nHEIGHT rises along the upright flange.\nNo numerical dimensions are required.","leader":null},{"id":"n8mb0abo","x":224.71260013621003,"y":54.82450005434921,"text":"EXERCISE1 - PDF113 / PAGE2-27\nThird-angle view-name exercise.\nUpper hatched shaft: SECTION A-A.\nUpper-right pictorial: ISOMETRIC.\nFar-left enlarged groove: DETAIL B.\nMiddle long shaft: FRONT / PARENT VIEW.\nMiddle-right circular end: RIGHT VIEW.\nLower shortened shaft: BREAK VIEW.\nLower-right mark: THIRD-ANGLE SYMBOL.\nA-A arrows identify the hatched section.\nCircleB identifies the enlarged DetailB.\nBreak boundaries omit the middle length.","leader":null},{"id":"nmv07v4k","x":34.73022865082227,"y":169.81382300324242,"text":"Positional answers refer to the supplied book figures.\nThis worksheet does not recreate or dimension their solids.","leader":null}],"primitives":[],"images":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"Planchard Ch2 IN-CHAPTER view labels - browser 2026-10-10","number":"","author":"","company":"","material":"","finish":"","mass":"","date":"","tolerance":""},"assemblyLayout":false,"seeded":true},"lastStandardsAudit":{"at":1791663788765,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2uc002"}},"attachments":[]}