[],\"entities\":[],\"id\":\"sk_1065m\",\"name\":\"X·Z sketch\",\"offset\":0,\"plane\":\"top\",\"points\":[],\"referenceId\":\"plane:top\"}]}","issues":[],"rebuiltAt":1791661247728},"price":500,"col":"#c9bfae","constraints":[],"rollback":null,"activeSketch":"sk_1065m","variables":[],"referenceGeometry":[{"id":"plane:top","type":"reference_plane","name":"Top Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":1,"z":0},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:front","type":"reference_plane","name":"Front Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":0,"y":0,"z":1},"xAxis":{"x":1,"y":0,"z":0}},{"id":"plane:right","type":"reference_plane","name":"Right Plane","origin":{"x":0,"y":0,"z":0},"normal":{"x":1,"y":0,"z":0},"xAxis":{"x":0,"y":0,"z":1}},{"id":"axis:x","type":"reference_axis","name":"X Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":1,"y":0,"z":0}},{"id":"axis:y","type":"reference_axis","name":"Y Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":1,"z":0}},{"id":"axis:z","type":"reference_axis","name":"Z Axis","origin":{"x":0,"y":0,"z":0},"direction":{"x":0,"y":0,"z":1}}],"definitionId":"cm_mv2ssd97","documentVersion":1,"context":{"kind":"part","units":{"length":"mm","angle":"deg","mass":"kg","precision":3},"activeCoordinateSystemId":"origin"},"customProperties":{"Description":"Inferred surface identification, PDF 71-73 / printed 1-43-1-45; not publisher answer key."},"drawing":{"version":1,"draftingStandard":"custom","secondaryUnits":"","secondaryPrecision":2,"size":"A3","orientation":"landscape","projection":"third","units":"mm","scale":"fit","showHidden":true,"showCenters":true,"showZones":true,"views":[],"dims":[],"notes":[{"id":"nj3nhown","x":40.85704456393054,"y":28.922440602138195,"text":"CHAPTER 1 IN-CHAPTER: PLANE 1, 3, 5\nPDF 71-73 / printed 1-43-1-45\nInferred visible-area solutions; not a publisher answer key.\nEdge-on surfaces are excluded from these area lists.","leader":null},{"id":"nxfxtw3q","x":40.85704456393054,"y":63.95103168935209,"text":"PLANE 1 - PDF 71 / 1-43\nProjected visible areas: FRONT A,D; TOP A,C; RIGHT B.\nA is the ramp; C its rear horizontal land;\nD the front fascia; B the right side profile.\n\nPLANE 3 - PDF 72 / 1-44\nFRONT D,G; TOP A,B,C,F; RIGHT A,E.\nThe ramp A slopes across width; D is the rear inner wall.\nExclude merely edge-on areas from these lists.\n\nPLANE 5 - PDF 73 / 1-45\nFRONT B,D,F; TOP A,B,E; RIGHT B,C.\nB is the oblique triangular corner facet.\nIt projects an area in all three principal views.","leader":null}],"primitives":[],"images":[],"title":{"revision":"A","sheet":1,"sheets":1,"title":"Planchard Ch1 IN-CHAPTER Plane 1 3 5 - browser 2026-10-10","number":"","author":"","company":"","material":"","finish":"","mass":"","date":"","tolerance":""},"assemblyLayout":false,"seeded":true},"lastStandardsAudit":{"at":1791661171997,"ok":true,"checked":0,"blocking":[]},"exactTopologyCache":{}},"assemblies":[],"drawings":[],"metadata":{"generator":"ModelForge CAD SolidWorks-Class","units":"mm","attachmentStorage":"content-addressed","activeDocument":{"type":"part","key":"cm_mv2ssd97"}},"attachments":[]}