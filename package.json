{
  "name": "modelforge-cad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/relay.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:modules": "node tools/module_check.mjs",
    "check:links": "node tools/link_check.mjs",
    "check:assertions": "node tools/comment_assertions.mjs",
    "check": "node tools/module_check.mjs && node tools/link_check.mjs && node tools/comment_assertions.mjs",
    "ci": "npm run check && npm test && npm run test:browser",
    "test:browser": "node --test --test-concurrency=3 tests/*.browser.mjs"
  },
  "dependencies": {
    "opencascade.js": "2.0.0-beta.b5ff984"
  }
}
