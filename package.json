{
  "name": "modelforge-cad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/relay.mjs",
    "desktop:bundle": "node tools/desktop_bundle.mjs",
    "setup:blueprint": "node tools/setup_blueprint_vision.mjs",
    "test": "node --test --test-timeout=600000 tests/*.test.mjs uikit/tests/*.test.mjs",
    "test:quiet": "node tools/test_changed.mjs --all",
    "test:changed": "node tools/test_changed.mjs",
    "check:modules":"node tools/module_check.mjs",
    "check:links": "node tools/link_check.mjs",
    "check:assertions": "node tools/comment_assertions.mjs",
    "check:sizes": "node tools/size_check.mjs",
    "check": "node tools/module_check.mjs && node tools/link_check.mjs && node tools/comment_assertions.mjs && node tools/size_check.mjs",
    "ci": "npm run check && npm test && npm run test:browser",
    "test:browser": "node --test --test-concurrency=3 tests/*.browser.mjs",
    "audit:overlaps": "node tools/deep_overlap_audit.mjs",
    "audit:contrast": "node tools/color_contrast_audit.mjs",
    "audit:all": "node tools/deep_overlap_audit.mjs && node tools/color_contrast_audit.mjs",
    "dataset:tutor": "node tools/generate_tutor_dataset.mjs",
    "eval:tutor": "node tools/evaluate_tutor_policy.mjs",
    "mcp:agent": "node server/agent_mcp.mjs"
  },
  "dependencies": {
    "opencascade.js": "2.0.0-beta.b5ff984"
  }
}
